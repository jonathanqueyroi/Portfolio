// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Modèle pour les projets
model Project {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String
  content     String    @db.Text
  imageUrl    String?
  demoUrl     String?
  githubUrl   String?
  technologies String[]
  featured    Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Modèle pour les expériences professionnelles
model Experience {
  id          String    @id @default(cuid())
  company     String
  position    String
  startDate   DateTime
  endDate     DateTime?
  current     Boolean   @default(false)
  description String    @db.Text
  technologies String[]
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Modèle pour les compétences
model Skill {
  id          String    @id @default(cuid())
  name        String
  category    String    // e.g., "Frontend", "Backend", "DevOps"
  level       Int       // 1-5 pour représenter votre niveau
  icon        String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ContactMessage {
  id         String        @id @default(cuid())
  name       String
  email      String
  message    String
  subject    String?
  phone      String?
  company    String?
  status     MessageStatus @default(NEW)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

// Modèle pour l'utilisateur administrateur
model User {
  id          String    @id @default(cuid())
  username    String    @unique
  email       String    @unique
  password    String    // Stockez toujours le hash du mot de passe, jamais en clair
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Modèle pour les statistiques de visite (optionnel)
model PageView {
  id          String    @id @default(cuid())
  page        String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
}
